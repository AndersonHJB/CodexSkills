{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build WeChat Sticker Pack Plan",
  "type": "object",
  "required": [
    "schema_version",
    "platform_spec",
    "rules_status",
    "rules_checked_at",
    "pack",
    "character_bible",
    "style_bible",
    "avoid",
    "anchor_prompt",
    "render",
    "stickers",
    "assets",
    "manual_review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "platform_spec": {
      "type": "string",
      "minLength": 1
    },
    "rules_status": {
      "enum": [
        "official-current",
        "changed-unsupported",
        "snapshot-unverified"
      ]
    },
    "rules_checked_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rules_change_details": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pack": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "introduction",
        "copyright",
        "type",
        "category",
        "character",
        "styles",
        "theme",
        "download_region",
        "listing_region",
        "price",
        "ai_generated",
        "rights_confirmed",
        "portrait_use_confirmed"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "pattern": "^[\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uF900-\\uFAFF]+$"
        },
        "introduction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "copyright": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "type": {
          "const": "静态表情"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "character": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "styles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "download_region": {
          "enum": [
            "全球",
            "中国大陆"
          ]
        },
        "listing_region": {
          "const": "中国大陆"
        },
        "price": {
          "enum": [
            "免费",
            "10 微信豆",
            "10微信豆"
          ]
        },
        "ai_generated": {
          "const": true
        },
        "rights_confirmed": {
          "type": "boolean"
        },
        "portrait_use_confirmed": {
          "type": "boolean"
        }
      }
    },
    "character_bible": {
      "type": "object",
      "minProperties": 1
    },
    "style_bible": {
      "type": "object",
      "minProperties": 1
    },
    "avoid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "anchor_prompt": {
      "type": "string",
      "minLength": 1
    },
    "render": {
      "type": "object",
      "required": [
        "background",
        "master_size",
        "default_text"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "master_size": {
          "type": "integer",
          "minimum": 480,
          "maximum": 4096
        },
        "font_path": {
          "type": ["string", "null"]
        },
        "default_text": {
          "type": "object",
          "required": [
            "min_font_size",
            "max_font_size",
            "max_lines",
            "fill",
            "stroke_fill",
            "stroke_width"
          ],
          "properties": {
            "min_font_size": {"type": "integer", "minimum": 8, "maximum": 120},
            "max_font_size": {"type": "integer", "minimum": 8, "maximum": 160},
            "max_lines": {"type": "integer", "minimum": 1, "maximum": 2},
            "fill": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "stroke_fill": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "stroke_width": {"type": "integer", "minimum": 0, "maximum": 12}
          }
        }
      }
    },
    "stickers": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "intent_key",
          "category",
          "exact_text",
          "meaning_word",
          "emotion",
          "pose_action",
          "prop",
          "framing",
          "text_zone",
          "line_break",
          "art_prompt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-9]|20)$"
          },
          "intent_key": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "exact_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "meaning_word": {
            "type": "string",
            "pattern": "^[\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uF900-\\uFAFF]{1,4}$"
          },
          "emotion": {
            "type": "string",
            "minLength": 1
          },
          "pose_action": {
            "type": "string",
            "minLength": 1
          },
          "prop": {
            "type": [
              "string",
              "null"
            ]
          },
          "framing": {
            "enum": [
              "close_up",
              "bust",
              "half_body",
              "full_body"
            ]
          },
          "text_zone": {
            "enum": [
              "top",
              "bottom"
            ]
          },
          "line_break": {
            "type": [
              "string",
              "array",
              "null"
            ]
          },
          "art_prompt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "required": [
        "banner_prompt",
        "cover_prompt",
        "icon_prompt"
      ],
      "properties": {
        "banner_prompt": {
          "type": "string",
          "minLength": 1
        },
        "cover_prompt": {
          "type": "string",
          "minLength": 1
        },
        "icon_prompt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manual_review": {
      "type": "object",
      "required": [
        "banner_has_no_text_or_numbers",
        "source_art_has_no_gibberish",
        "character_consistent",
        "text_visually_correct",
        "publication_assets_visually_clean",
        "rights_reviewed"
      ],
      "properties": {
        "banner_has_no_text_or_numbers": {
          "type": "boolean"
        },
        "source_art_has_no_gibberish": {
          "type": "boolean"
        },
        "character_consistent": {
          "type": "boolean"
        },
        "text_visually_correct": {
          "type": "boolean"
        },
        "publication_assets_visually_clean": {
          "type": "boolean"
        },
        "rights_reviewed": {
          "type": "boolean"
        }
      }
    }
  }
}
